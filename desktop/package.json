{
  "name": "shelf-made-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Shelf Made desktop wrapper (Electron). Saves go to the user's data folder.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:web": "cd .. && npm run build",
    "dist": "npm run build:web && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "build": {
    "appId": "com.shelfmade.game",
    "productName": "Shelf Made",
    "files": ["main.cjs", "preload.cjs", "steam.cjs", "../dist/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
